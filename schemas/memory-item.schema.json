{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maqs.dev/schemas/way-0.1.3/memory-item.schema.json",
  "title": "MAQS-Way v0.1.3 memory-item (OMPS base + Way extension)",
  "description": "Structural contract for a live Way record, SPEC §2.1 v0.1.3. Extends OMPS memory-item with OAMP §4.3 binding, visible_to masking and Way lifecycle fields. status is a derived view and MUST NOT be stored (see not.required).",
  "type": "object",
  "not": {
    "required": ["status"]
  },
  "required": [
    "id",
    "type",
    "subject",
    "scope",
    "content",
    "sensitivity",
    "consent",
    "retention",
    "provenance",
    "embedding",
    "links",
    "schema_version",
    "revision"
  ],
  "properties": {
    "schema_version": {
      "const": "omps-0.1.0+way-v0.1.3",
      "description": "OMPS base + Way extension, semver extension documented (SPEC §2.1)."
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": ["preference", "episode", "semantic", "procedural", "project", "system"]
    },
    "subject": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["user", "agent", "team", "org", "system"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["user-portable", "agent-private", "team-shared", "org-shared", "local-session"]
        }
      }
    },
    "content": {
      "type": "object",
      "required": ["format", "value"],
      "properties": {
        "format": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "sensitivity": {
      "enum": ["low", "medium", "high", "secret"]
    },
    "consent": {
      "type": "object",
      "required": [
        "basis",
        "exportable",
        "shareable_with_agents",
        "usable_for_personalization",
        "usable_for_training",
        "requires_confirmation_before_use"
      ],
      "properties": {
        "basis": {
          "enum": ["explicit_user_request", "inferred", "imported"]
        },
        "exportable": {
          "type": "boolean"
        },
        "shareable_with_agents": {
          "type": "boolean"
        },
        "usable_for_personalization": {
          "type": "boolean"
        },
        "usable_for_training": {
          "type": "boolean"
        },
        "requires_confirmation_before_use": {
          "type": "boolean"
        }
      }
    },
    "retention": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["until_deleted", "ttl", "sliding_window", "legal_hold"]
        },
        "ttl_days": {
          "type": "integer",
          "minimum": 1
        },
        "valid_from": {
          "type": ["string", "null"]
        },
        "valid_to": {
          "type": ["string", "null"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "created_at",
        "created_by",
        "source",
        "policy_id",
        "policy_version",
        "confidence",
        "confidence_after",
        "transformation_history",
        "sources",
        "visible_to"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "created_by": {
          "type": "object",
          "required": ["type", "id"],
          "properties": {
            "type": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source": {
          "type": "object",
          "required": ["type", "ref", "hash"],
          "properties": {
            "type": {
              "enum": ["conversation", "file", "web", "agent", "model_output"]
            },
            "ref": {
              "type": "string"
            },
            "hash": {
              "type": "string"
            }
          }
        },
        "policy_id": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_after": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "transformation_history": {
          "type": "array"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["agent_id", "session_id", "task_id", "timestamp"]
          }
        },
        "visible_to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of subject.id for which the record is visible; absent = unrestricted within scope (SPEC §2.1)."
        }
      }
    },
    "embedding": {
      "type": "object",
      "required": ["model", "version", "derived_from_trust", "vector_id"],
      "properties": {
        "model": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "derived_from_trust": {
          "type": "string"
        },
        "vector_id": {
          "type": "string"
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "links": {
      "type": "object",
      "required": ["supersedes", "derived_from", "invalidated_by", "contested_by"],
      "properties": {
        "supersedes": {
          "type": ["string", "null"]
        },
        "derived_from": {
          "type": "array"
        },
        "invalidated_by": {
          "type": ["string", "null"]
        },
        "contested_by": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
