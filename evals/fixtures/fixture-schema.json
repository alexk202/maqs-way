{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maqs-way/evals/fixtures/fixture-schema.json",
  "title": "Two-arm comparative fixture (twoarm-v1)",
  "description": "Declarative definition of one comparative experiment: a mechanism required or discussed by a standard item is switched on in one arm and off in the other, everything else held equal. The runner is generic; adding an experiment means adding a fixture, not writing code. A fixture is not a memory system: the store is this file, not a database.",
  "type": "object",
  "required": ["fixture_version", "fixture_id", "item_under_test", "mechanism", "prompt_assembly", "store", "probes", "arms", "scoring", "runs_per_cell", "sampling", "controls", "decision_rule", "honest_boundaries"],
  "additionalProperties": false,
  "properties": {
    "fixture_version": {"const": "twoarm-v1"},
    "fixture_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "item_under_test": {
      "type": "object",
      "required": ["standard", "standard_version", "item", "item_text"],
      "additionalProperties": false,
      "properties": {
        "standard": {"type": "string"},
        "standard_version": {"type": "string"},
        "item": {"type": "string"},
        "item_text": {"type": "string"},
        "compliant_behavior": {"type": "string", "description": "What the item actually requires. Stated so it is visible whether any arm is compliant at all."}
      }
    },
    "mechanism": {
      "type": "object",
      "required": ["name", "description", "realization", "wording_origin", "note_applies_on"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "realization": {"type": "string", "description": "Exact text or transformation applied in the ON arm."},
        "wording_origin": {"type": "string", "description": "Whose wording the realization is. Required so a test of a mechanism class is never mistaken for a test of someone's product."},
        "note_applies_on": {"enum": ["fallback_only", "always"], "description": "fallback_only: the mechanism fires only when no stored record is relevant, so probes with a relevant record run in one arm only."}
      }
    },
    "prompt_assembly": {
      "type": "object",
      "required": ["mode", "system", "memory_header", "record_format", "note_position", "context_isolation"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["chat"]},
        "system": {"type": "string"},
        "memory_header": {"type": "string"},
        "record_format": {"type": "string", "description": "Per-record line; {text} is substituted."},
        "note_position": {"enum": ["before_memory_header"]},
        "context_isolation": {"const": "each generation is an independent request; no conversation, cache or state is carried between runs"}
      }
    },
    "store": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["record_id", "text", "marker", "vocabulary"],
        "additionalProperties": false,
        "properties": {
          "record_id": {"type": "string"},
          "text": {"type": "string"},
          "marker": {"type": "string", "description": "Unique token planted in the record; its appearance in an answer is objective evidence the record was used."},
          "vocabulary": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Pre-registered distinctive words of this record. Closed before the run; matching is case-insensitive substring over this list only."}
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["probe_id", "query", "role", "run_in"],
        "additionalProperties": false,
        "properties": {
          "probe_id": {"type": "string"},
          "query": {"type": "string"},
          "role": {"enum": ["offtopic", "positive_control"]},
          "run_in": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Arm ids this probe runs in. A positive control under note_applies_on=fallback_only runs in the OFF arm only, because the mechanism would not fire for it."}
        }
      }
    },
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["arm_id", "mechanism_on"],
        "additionalProperties": false,
        "properties": {
          "arm_id": {"type": "string"},
          "mechanism_on": {"type": "boolean"}
        }
      }
    },
    "scoring": {
      "type": "object",
      "required": ["primary", "secondary"],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "object",
          "required": ["rule", "case_insensitive", "unit"],
          "additionalProperties": false,
          "properties": {
            "rule": {"const": "marker_or_vocabulary_match"},
            "case_insensitive": {"type": "boolean"},
            "unit": {"const": "one run counts once if any record matched"}
          }
        },
        "secondary": {
          "type": "object",
          "required": ["rule", "subjective", "reported_separately"],
          "additionalProperties": false,
          "properties": {
            "rule": {"const": "paraphrase_review"},
            "subjective": {"const": true},
            "reported_separately": {"const": true}
          }
        }
      }
    },
    "runs_per_cell": {"type": "integer", "minimum": 2},
    "sampling": {
      "type": "object",
      "required": ["temperature", "top_p", "max_tokens", "seed_scheme", "seed_example"],
      "additionalProperties": false,
      "properties": {
        "temperature": {"type": "number"},
        "top_p": {"type": "number"},
        "max_tokens": {"type": "integer"},
        "seed_scheme": {"type": "string"},
        "seed_example": {"type": "string"}
      }
    },
    "controls": {
      "type": "object",
      "required": ["positive_control", "empty_store"],
      "additionalProperties": false,
      "properties": {
        "positive_control": {
          "type": "object",
          "required": ["probe", "arm", "runs", "min_rate"],
          "additionalProperties": false,
          "properties": {
            "probe": {"type": "string"},
            "arm": {"type": "string"},
            "runs": {"type": "integer", "minimum": 2},
            "min_rate": {"type": "number", "description": "Below this rate the pipeline is broken and the whole run is VOID, not a result."}
          }
        },
        "empty_store": {
          "type": "object",
          "required": ["probe", "arm", "runs", "role"],
          "additionalProperties": false,
          "properties": {
            "probe": {"type": "string"},
            "arm": {"type": "string"},
            "runs": {"type": "integer", "minimum": 2},
            "role": {"type": "string", "description": "Why this cell exists: scorer sanity, and the reference for the item's compliant behavior."}
          }
        }
      }
    },
    "decision_rule": {
      "type": "object",
      "required": ["method", "confidence", "direction_definition", "homogeneity_check", "detection_threshold", "on_overlap"],
      "additionalProperties": false,
      "properties": {
        "method": {"const": "wilson_ci_nonoverlap"},
        "confidence": {"type": "number"},
        "direction_definition": {"type": "string", "description": "Must be unambiguous, e.g. upper(A) < lower(B), not 'A is lower'."},
        "homogeneity_check": {"type": "string", "description": "Pre-registered condition under which the pooled verdict is withheld."},
        "detection_threshold": {"type": "string", "description": "Smallest gap the chosen n can separate, stated before the run."},
        "on_overlap": {"type": "string"}
      }
    },
    "honest_boundaries": {"type": "string"}
  }
}
